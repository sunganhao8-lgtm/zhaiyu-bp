# 宅域项目 .gitignore
# 参考 Karpathy LLM Wiki 的"原始素材不入库"原则

# ── 操作系统 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Git ──
.git/

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── 大文件原始素材（不入库，按需引用） ──
raw/meetings/**/*.mp4
raw/meetings/**/*.wemtv
raw/meetings/**/*.wemta
raw/meetings/**/*.wemtc
raw/meetings/**/*.wemtvidx
raw/meetings/**/*.wemtaidx

# ── 旧版大文件（在 archive/ 中，需要时手动引用） ──
archive/**/*.MP4
archive/**/*.mp4

# ── 中间产物（非交付物） ──
# layout work files, temp exports
*.tmp
*.temp
node_modules/

# ── Source maps (3 MB+, 仅 dev 使用) ──
*.map
*.js.map

# ── 数据缓存（地图瓦片等，按需手动下载） ──
**/vendor/osm-tiles/

# 孤儿目录：线上入口是仓库根 bp.html，不部署 bps/store-front/bp.html
bps/store-front/

# 合作着陆页：独立 git 仓库 github.com/sunganhao8-lgtm/zhaiyu-coop（线上 sunganhao8-lgtm.github.io/zhaiyu-coop），不并入主仓库
bps/landing-for-coop/

# 装修/效果图/搜索结果/抓取素材 — 本地工作目录，not for 仓库
装修/

# 临时目录：审计中间产物（review / audit / test）
tmp/
.tmp/
